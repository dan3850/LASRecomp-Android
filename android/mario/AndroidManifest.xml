<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.retroaura.mario.snxruntime">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- User opt-in only: direct POSIX read of a selected external RomFS tree, no 2.9GB copy. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <application android:label="Mario SNX Runtime TESTE" android:hasCode="true"
        android:allowBackup="false" android:extractNativeLibs="true">
        <activity android:name="com.retroaura.lasrecomp.MarioBootActivity"
            android:label="Mario SNX Runtime TESTE" android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Separate process prevents ScarletNX SDL/Horizon CPU from sharing LASRecomp global state. -->
        <activity android:name="com.retroaura.lasrecomp.MarioSnxGameActivity"
            android:label="Mario SNX Runtime TESTE"
            android:process=":snx"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|layoutDirection|locale|fontScale" />
        <activity android:name="com.retroaura.lasrecomp.GameSDLActivity"
            android:label="Mario SNX Runtime TESTE" android:exported="false"
            android:hardwareAccelerated="true" android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|layoutDirection|locale|fontScale" />
    </application>
</manifest>
