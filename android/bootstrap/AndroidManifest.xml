<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.retroaura.lasrecomp.bootdiag">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <application
        android:label="LASRecomp Boot TESTE"
        android:hasCode="true"
        android:allowBackup="false"
        android:extractNativeLibs="true">
        <!-- App-owned game file import: no Termux at runtime. -->
        <activity
            android:name="com.retroaura.lasrecomp.GameImportActivity"
            android:label="LASRecomp Boot TESTE"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Official SDL3 Android lifecycle for the REAL game runtime.
             Deliberately not exposed until the runtime and recompiler link. -->
        <activity
            android:name="com.retroaura.lasrecomp.GameSDLActivity"
            android:label="LASRecomp Game"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|layoutDirection|locale|fontScale" />
    </application>
</manifest>
